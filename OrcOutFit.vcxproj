<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <RootNamespace>OrcOutFit</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <PluginSdkDir>$(ProjectDir)source\external\plugin-sdk</PluginSdkDir>
    <PluginSdkLibraryName>Plugin.lib</PluginSdkLibraryName>
  </PropertyGroup>
  <!--
    OrcEdition: Full (по умолчанию) собирает OrcOutFit.asi (полный функционал).
    Lite (msbuild /p:OrcEdition=Lite) собирает OrcOutFitLite.asi: только рендер оружия
    на теле + меню (Main + sub-tab «Рендер оружия»). Тяжёлые TU исключаются (см. ItemGroup),
    макрос ORC_LITE гейтит код, OpenAL не линкуется и не пересобирается в PreBuild.
  -->
  <PropertyGroup Label="OrcEdition">
    <OrcEdition Condition="'$(OrcEdition)'==''">Full</OrcEdition>
    <OrcLiteDefine Condition="'$(OrcEdition)'=='Lite'">ORC_LITE;</OrcLiteDefine>
    <OrcOpenAlLibs Condition="'$(OrcEdition)'!='Lite'">OpenAL32.lib;</OrcOpenAlLibs>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)build\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)build\obj\$(Configuration)\$(OrcEdition)\OrcOutFit\</IntDir>
    <TargetName Condition="'$(OrcEdition)'=='Lite'">OrcOutFitLite</TargetName>
    <TargetName Condition="'$(OrcEdition)'!='Lite'">OrcOutFit</TargetName>
    <TargetExt>.asi</TargetExt>
    <OrcOpenAlInclude>$(ProjectDir)source\external\openal-soft\include;$(ProjectDir)build\openal-soft</OrcOpenAlInclude>
    <OrcOpenAlLibDir>$(ProjectDir)build\openal-soft\$(Configuration)</OrcOpenAlLibDir>
    <OrcOpenAlPreBuild>powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\.github\scripts\build-openal-soft.ps1" -Configuration $(Configuration) -ProjectDir "$(MSBuildProjectDirectory)"</OrcOpenAlPreBuild>
    <OrcBuildPdb Condition="'$(OrcBuildPdb)'==''">true</OrcBuildPdb>
    <OrcDebugInformationFormat Condition="'$(OrcBuildPdb)'=='true'">ProgramDatabase</OrcDebugInformationFormat>
    <OrcDebugInformationFormat Condition="'$(OrcBuildPdb)'!='true'">None</OrcDebugInformationFormat>
    <OrcGenerateDebugInformation Condition="'$(OrcBuildPdb)'=='true'">true</OrcGenerateDebugInformation>
    <OrcGenerateDebugInformation Condition="'$(OrcBuildPdb)'!='true'">false</OrcGenerateDebugInformation>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>$(OrcLiteDefine)WIN32;_WINDOWS;_CRT_SECURE_NO_WARNINGS;AL_LIBTYPE_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(OrcOpenAlInclude);$(ProjectDir)source;$(ProjectDir)source\external\simpleini;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(OrcOpenAlLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(OrcOpenAlLibs)winmm.lib;avrt.lib;ole32.lib;uuid.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PreBuildEvent Condition="'$(OrcOpenAlSkipPreBuild)' != 'true' and '$(OrcEdition)' != 'Lite'">
      <Command>$(OrcOpenAlPreBuild)</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>$(OrcLiteDefine)WIN32;_WINDOWS;_CRT_SECURE_NO_WARNINGS;NDEBUG;GTASA;PLUGIN_SGV_10US;RW;NOMINMAX;AL_LIBTYPE_STATIC;IMGUI_DISABLE_DEBUG_TOOLS;IMGUI_DISABLE_OBSOLETE_KEYIO;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>false</ConformanceMode>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <StringPooling>true</StringPooling>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <!-- Size-first codegen: /O1 (MinSpace) + /Os; plugin is not CPU-bound. -->
      <Optimization>MinSpace</Optimization>
      <!-- /MT: Plugin.lib (plugin-sdk, prebuilt) собран под /MT — держим CRT консистентным. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <FavorSizeOrSpeed>Size</FavorSizeOrSpeed>
      <!-- Aggressive profile: no security cookies, no RTTI, C++ exceptions off (SEH still works). -->
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <ExceptionHandling>false</ExceptionHandling>
      <DebugInformationFormat>$(OrcDebugInformationFormat)</DebugInformationFormat>
      <InlineFunctionExpansion>OnlyExplicitInline</InlineFunctionExpansion>
      <OmitFramePointers>true</OmitFramePointers>
      <EnableEnhancedInstructionSet>StreamingSIMDExtensions2</EnableEnhancedInstructionSet>
      <AdditionalOptions>/utf-8 /Gw /GS- /Zc:threadSafeStatics- %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(OrcOpenAlInclude);$(PluginSdkDir)\plugin_sa;$(PluginSdkDir)\plugin_sa\game_sa;$(PluginSdkDir)\plugin_sa\game_sa\rw;$(PluginSdkDir)\shared;$(PluginSdkDir)\shared\game;$(PluginSdkDir)\shared\dxsdk;$(PluginSdkDir)\injector;$(PluginSdkDir)\hooking;$(PluginSdkDir)\safetyhook;$(ProjectDir)source\external\imgui;$(ProjectDir)source\external\imgui\backends;$(ProjectDir)source\external\simpleini;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>$(OrcGenerateDebugInformation)</GenerateDebugInformation>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <AdditionalLibraryDirectories>$(OrcOpenAlLibDir);$(PluginSdkDir)\output\lib;$(PluginSdkDir)\shared\dxsdk;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(OrcOpenAlLibs)winmm.lib;avrt.lib;ole32.lib;uuid.lib;$(PluginSdkLibraryName);d3d9.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PreBuildEvent Condition="'$(OrcOpenAlSkipPreBuild)' != 'true' and '$(OrcEdition)' != 'Lite'">
      <Command>$(OrcOpenAlPreBuild)</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
